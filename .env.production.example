# ============================================================
# NextCart 生产环境变量（自托管 Docker 部署用）
# 复制为 .env.production 后填写：cp .env.production.example .env.production
# 该文件含密码/密钥，只放在服务器上，永不提交 git
# ============================================================

# ---------- 数据库（docker-compose 内置的 PostgreSQL） ----------
# 注意：host 必须是 compose 服务名 db，密码与 docker-compose.yml 的 POSTGRES_PASSWORD 一致
DATABASE_URL="postgresql://nextcart:change-me-strong-password@db:5432/nextcart?sslmode=disable"

# 若改用外部数据库（如 Supabase / 云 RDS），把上面换成对应连接串：
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# ---------- 站点地址 ----------
# 服务器 IP 或域名；决定支付回跳地址，务必正确
NEXT_PUBLIC_APP_URL="http://你的服务器IP:3000"

# ---------- Stripe（可选，不填则走本地模拟支付） ----------
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---------- Supabase Auth（可选，自托管可不用） ----------
# NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ---------- 管理后台初始管理员 ----------
# 首个注册用户自动成为 ADMIN；生产环境建议部署后立刻注册并设为管理员
