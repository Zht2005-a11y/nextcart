# ============================================================
# NextCart 环境变量模板
# 本地开发：复制为 .env.local（服务端代码会读取 .env 与 .env.local）
# 生产部署：在 Vercel / Docker 的环境变量配置中逐项填写
# ============================================================

# ---------- 数据库（Supabase PostgreSQL） ----------
# 连接字符串（Prisma 运行时 + 迁移）
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
# 直连地址（Prisma CLI 执行迁移使用，避免连接池限制）
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres?sslmode=require"

# 本地开发模式（无 Supabase 时）：
# DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."  ← prisma dev 生成的本地库
# 应用会自动把 prisma+postgres:// 转为直连 postgres:// 使用

# ---------- Supabase Auth（可选，本地开发可不配） ----------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # 仅服务端使用，切勿暴露

# ---------- Stripe 支付（测试模式） ----------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---------- 站点地址 ----------
# 支付成功/取消回跳、绝对链接使用；生产环境填部署域名
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- OpenAI（可选，AI 模块） ----------
OPENAI_API_KEY="sk-..."
